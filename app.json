{
  "expo": {
    "name": "TabTensor",
    "slug": "tabtensor",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "scheme": "tabtensor",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tabtensor.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "TabTensor uses the microphone only to detect guitar pitch."
      }
    },
    "android": {
      "package": "com.tabtensor.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#0E0F13"
      }
    },
    "plugins": [
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "TabTensor uses the microphone only to detect guitar pitch.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InstrumentSans-Regular.ttf",
            "./assets/fonts/InstrumentSans-Medium.ttf",
            "./assets/fonts/InstrumentSans-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F13"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#0E0F13"
  }
}
